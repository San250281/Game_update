{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User account and statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "provider": { "type": "string", "enum": ["google", "facebook", "email", "guest"] },
        "coins": { "type": "number" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["uid", "name", "email", "photoURL", "provider", "coins", "referralCode", "createdAt", "isActive"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Coin credit or debit log",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "uid": { "type": "string" },
        "type": { "type": "string", "enum": ["credit", "debit"] },
        "coins": { "type": "number" },
        "source": { "type": "string", "enum": ["game", "ad", "referral", "bonus", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["transactionId", "uid", "type", "coins", "source", "createdAt"]
    },
    "referral": {
      "title": "Referral Record",
      "description": "Logs invited signups",
      "type": "object",
      "properties": {
        "referralId": { "type": "string" },
        "referrerUid": { "type": "string" },
        "newUserUid": { "type": "string" },
        "rewardGranted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referralId", "referrerUid", "newUserUid", "rewardGranted", "createdAt"]
    },
    "game_session": {
      "title": "Game Session",
      "description": "Logs a completed mini-game play session",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "uid": { "type": "string" },
        "gameId": { "type": "string", "enum": ["spin_wheel", "scratch_card", "quiz", "tap_challenge"] },
        "score": { "type": "number" },
        "coinsEarned": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "uid", "gameId", "score", "coinsEarned", "createdAt"]
    }
  },
  "firestore": {
    "users/{uid}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "Global user profiles"
    },
    "transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/transaction" },
      "description": "Coin transaction history log"
    },
    "referrals/{referralId}": {
      "schema": { "$ref": "#/entities/referral" },
      "description": "Tracking invites and rewards"
    },
    "game_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/game_session" },
      "description": "Player scores and game rewards histories"
    }
  }
}
