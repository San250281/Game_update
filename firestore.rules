rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // Primatives & Global Helpers
    // ----------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      // Bootstrapped Admin defined from developer email and collection record lookup
      return isSignedIn() && (
        request.auth.token.email == 'game.rewardyn@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ----------------------------------------------------
    // Entites Schema Validations
    // ----------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'photoURL', 'provider', 'coins', 'referralCode', 'createdAt', 'isActive'])
        && data.keys().size() <= 15
        && data.uid is string && data.uid.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.email is string && data.email.size() <= 256
        && data.photoURL is string && data.photoURL.size() <= 2000
        && data.provider in ['google', 'facebook', 'email', 'guest']
        && data.coins is number && data.coins >= 0
        && data.referralCode is string && data.referralCode.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.isActive is bool;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['transactionId', 'uid', 'type', 'coins', 'source', 'createdAt'])
        && data.keys().size() == 6
        && data.transactionId is string && data.transactionId.size() <= 128
        && data.uid is string && data.uid.size() <= 128
        && data.type in ['credit', 'debit']
        && data.coins is number && data.coins >= 0
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.source in ['game', 'ad', 'referral', 'bonus', 'admin'];
    }

    function isValidReferral(data) {
      return data.keys().hasAll(['referralId', 'referrerUid', 'newUserUid', 'rewardGranted', 'createdAt'])
        && data.keys().size() == 5
        && data.referralId is string && data.referralId.size() <= 128
        && data.referrerUid is string && data.referrerUid.size() <= 128
        && data.newUserUid is string && data.newUserUid.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.rewardGranted is bool;
    }

    function isValidGameSession(data) {
      return data.keys().hasAll(['sessionId', 'uid', 'gameId', 'score', 'coinsEarned', 'createdAt'])
        && data.keys().size() == 6
        && data.sessionId is string && data.sessionId.size() <= 128
        && data.uid is string && data.uid.size() <= 128
        && data.gameId in ['spin_wheel', 'scratch_card', 'quiz', 'tap_challenge']
        && data.score is number && data.score >= 0
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.coinsEarned is number && data.coinsEarned >= 0;
    }

    function isValidWithdrawal(data) {
      return data.keys().hasAll(['requestId', 'uid', 'userName', 'userEmail', 'amountCoins', 'paymentMethod', 'paymentDetails', 'status', 'createdAt'])
        && data.keys().size() <= 11
        && data.requestId is string && data.requestId.size() <= 128
        && data.uid is string && data.uid.size() <= 128
        && data.userName is string && data.userName.size() <= 256
        && data.userEmail is string && data.userEmail.size() <= 256
        && data.amountCoins is number && data.amountCoins > 0
        && data.paymentMethod is string && data.paymentMethod.size() <= 100
        && data.paymentDetails is string && data.paymentDetails.size() <= 1000
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // ----------------------------------------------------
    // Collection Match Blocks
    // ----------------------------------------------------

    match /users/{uid} {
      allow read: if isSignedIn(); // Allow profile reading for scoreboard/display search, but email filtering remains protected
      allow create: if isOwner(uid) && isValidUser(incoming()) && incoming().coins <= 50 && incoming().createdAt is string && incoming().createdAt.size() <= 50;
      allow update: if (isOwner(uid) || isAdmin()) && isValidUser(incoming())
                     && incoming().uid == existing().uid
                     && incoming().createdAt == existing().createdAt
                     && (
                       isAdmin() ||
                       incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'referredBy', 'lastLogin', 'name', 'photoURL', 'isActive'])
                     );
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().uid == request.auth.uid || isAdmin()) && isValidTransaction(incoming()) && incoming().createdAt is string && incoming().createdAt.size() <= 50;
      allow update, delete: if false;
    }

    match /referrals/{referralId} {
      allow read: if isSignedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.newUserUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().referrerUid == request.auth.uid || incoming().newUserUid == request.auth.uid || isAdmin()) && isValidReferral(incoming()) && incoming().createdAt is string && incoming().createdAt.size() <= 50;
      allow update, delete: if false;
    }

    match /game_sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().uid == request.auth.uid || isAdmin()) && isValidGameSession(incoming()) && incoming().createdAt is string && incoming().createdAt.size() <= 50;
      allow update, delete: if false;
    }

    match /withdrawals/{requestId} {
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || request.auth.token.email == 'game.rewardyn@gmail.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if isSignedIn() && (incoming().uid == request.auth.uid || isAdmin()) && isValidWithdrawal(incoming()) && incoming().status == 'pending' && incoming().createdAt is string && incoming().createdAt.size() <= 50;
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
